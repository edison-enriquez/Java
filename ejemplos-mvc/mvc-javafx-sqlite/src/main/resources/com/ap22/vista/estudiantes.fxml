<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="640.0" spacing="6.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ap22.controlador.EstudianteController">
   <children>
      <Label style="-fx-font-size: 20px;" text="Gestión de Estudiantes" />
      <Label text="Nombre:" />
      <TextField fx:id="txtNombre" promptText="Ej: Ana Pérez" />
      <Label text="Correo:" />
      <TextField fx:id="txtCorreo" promptText="Ej: ana@correo.com" />
      <Label text="Nota (0.0 - 5.0):" />
      <TextField fx:id="txtNota" promptText="Ej: 4.5" />
      <HBox spacing="8.0">
         <children>
            <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#onGuardar" text="Guardar" />
            <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizar" text="Actualizar" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
         </children>
         <VBox.margin>
            <Insets bottom="8.0" top="8.0" />
         </VBox.margin>
      </HBox>
      <TextField fx:id="txtBuscar" onKeyReleased="#onBuscar" promptText="Buscar por nombre..." />
      <TableView fx:id="tblEstudiantes" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="75.0" text="ID" />
          <TableColumn fx:id="colNombre" prefWidth="75.0" text="Nombre" />
            <TableColumn fx:id="colCorreo" prefWidth="75.0" text="Correo" />
            <TableColumn fx:id="colNota" prefWidth="75.0" text="Nota" />
        </columns>
      </TableView>
      <Label fx:id="lblEstado" text="0 estudiante(s)" />
   </children>
   <padding>
      <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
   </padding>
</VBox>
