<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = "Project Object Model".
  Le dice a Maven QUÉ es el proyecto (groupId, artifactId, versión),
  QUÉ librerías necesita (dependencias) y CÓMO compilarlo y ejecutarlo (plugins).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Coordenadas del proyecto (se escribieron en el asistente de VS Code) -->
    <groupId>com.ap22</groupId>
    <artifactId>mvc-javafx-sqlite</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>Gestión de Estudiantes - JavaFX + MVC + DAO + SQLite</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>21.0.5</javafx.version>
        <sqlite.version>3.47.1.0</sqlite.version>
    </properties>

    <dependencies>
        <!-- JavaFX: controles (Button, TableView, ...) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- JavaFX: soporte para cargar archivos FXML (los que edita SceneBuilder) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <!-- Driver JDBC de SQLite: permite que Java hable con el archivo estudiantes.db -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
            <!-- Plugin oficial de JavaFX. Uso: mvnw clean javafx:run -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.ap22/com.ap22.App</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
